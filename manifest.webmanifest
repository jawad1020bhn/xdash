{
  "name": "X Bookmarks — Editorial Visual Archive",
  "short_name": "X Archive",
  "description": "A personal visual archive of everything you saved on X: discover, browse and watch your captured media.",
  "id": "/dashboard/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#FAF9FC",
  "theme_color": "#FAF9FC",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "photo", "social"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Watch feed",
      "url": "./index.html#w=watch",
      "description": "Jump straight into the immersive video feed"
    },
    {
      "name": "Library",
      "url": "./index.html#w=library",
      "description": "Browse and filter everything you've saved"
    },
    {
      "name": "Import / Manage",
      "url": "./index.html#w=manage",
      "description": "Move your archive in and out"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "edge_side_panel": {
    "preferred_width": 420
  }
}
