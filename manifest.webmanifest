{
  "name": "Archive \u2014 X bookmarks dashboard",
  "short_name": "Archive",
  "description": "A fast, private, offline-first visual dashboard for everything you saved on X.",
  "id": "/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0c0a09",
  "theme_color": "#0c0a09",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "photo",
    "social"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.jpg",
      "sizes": "512x512",
      "type": "image/jpeg"
    },
    {
      "src": "icons/icon-512.jpg",
      "sizes": "512x512",
      "type": "image/jpeg",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.jpg",
      "sizes": "512x512",
      "type": "image/jpeg",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Watch",
      "short_name": "Watch",
      "url": "./index.html#/watch",
      "description": "Open the immersive video feed"
    },
    {
      "name": "Library",
      "short_name": "Library",
      "url": "./index.html#/library",
      "description": "Browse and search everything you saved"
    },
    {
      "name": "Unseen",
      "short_name": "Unseen",
      "url": "./index.html#/home",
      "description": "Pick up with what you have not opened"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  }
}
